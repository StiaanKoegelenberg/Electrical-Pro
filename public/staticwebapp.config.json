{
  "routes": [
    { "route": "/solar", "rewrite": "/solar.html" },
    { "route": "/commercial", "rewrite": "/commercial.html" },
    { "route": "/agricultural", "rewrite": "/agricultural.html" },
    { "route": "/residential", "rewrite": "/residential.html" },
    { "route": "/privacy", "rewrite": "/privacy.html" },
    {
      "route": "/assets/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{png,jpg,jpeg,gif,webp,svg,ico,xml,txt,json,php}"]
  },
  "globalHeaders": {
    "X-Robots-Tag": "noindex, nofollow"
  }
}
