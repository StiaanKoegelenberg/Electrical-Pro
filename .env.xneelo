# Public settings for the build that goes on xneelo (npm run build:xneelo). Nothing secret goes here: it ends
# up in the page. This build doesn't read .env.production, so the Turnstile key is repeated here.

# The contact form's Cloudflare Turnstile widget (see src/components/site/Turnstile.tsx)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAF-Y2IAxWeh_0u8m

# The contact form's Azure function (production), called from electricalpro.co.za
VITE_CONTACT_ENDPOINT=https://happy-flower-09933630f.3.azurestaticapps.net/api/contact
